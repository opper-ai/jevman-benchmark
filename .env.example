# Option A — play with your own Opper key (local dev only; ignored when the redirect URI is https
# unless JEV_ALLOW_DEV_KEY=1, because it would pay for every signed-out visitor)
OPPER_API_KEY=
OPPER_BASE_URL=https://api.opper.ai

# Option C — your own TypeSafe key: jev calls go straight to TypeSafe's System One API (local dev only, like
# option A; wins over OPPER_API_KEY when both are set)
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional: another System One model instead of jev, for any of the options (e.g. opper/kev-4b, opper/clef)
JEV_MODEL=

# Option B — Login with Opper (players pay with their own Opper wallet)
OPPER_CLIENT_ID=
OPPER_CLIENT_SECRET=
# Empty means http://localhost:5173/auth/callback (the dev server), or the PUBLIC_BASE_URL one below.
OPPER_REDIRECT_URI=
# 32+ random characters, e.g. `openssl rand -hex 32` (required when the redirect URI is https)
SESSION_SECRET=

# Deployment below a path prefix (see README → Deployment). Leave empty to serve at the root.
# APP_BASE_PATH also sets Vite's `base` at build time; VITE_PUBLIC_URL is the public origin used in share links
# and social-card meta tags (default https://jevman.apps.chadda.se).
APP_BASE_PATH=
VITE_PUBLIC_URL=
# Public origin, e.g. https://opper.ai: without an explicit redirect URI, Login with Opper uses
# ${PUBLIC_BASE_URL}${APP_BASE_PATH}/auth/callback. OPPER_OAUTH_REDIRECT_URI, if set, wins over OPPER_REDIRECT_URI.
PUBLIC_BASE_URL=
OPPER_OAUTH_REDIRECT_URI=
